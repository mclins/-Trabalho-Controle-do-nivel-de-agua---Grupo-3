/*
 * adc.c - Aquisicao do sensor de nivel por interrupcao de fim de conversao
 *
 * Referencia AVcc (5 V): o MPX5010 e raciometrico (Vout proporcional a
 * Vs), entao usar a propria alimentacao como referencia cancela, na
 * razao Vout/Vref, as variacoes da fonte.
 *
 * Clock do ADC = 16 MHz / 128 = 125 kHz (dentro de 50-200 kHz exigidos
 * para 10 bits); conversao = 13 ciclos = 104 us.
 */
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/atomic.h>
#include "config.h"
#include "adc.h"

static volatile uint16_t soma;              /* soma das ultimas N amostras */
static volatile uint16_t ultima;
static volatile uint8_t  pronto;
static uint16_t janela[ADC_MEDIA_N];
static uint8_t  idx;

void adc_init(void)
{
    ADMUX  = (1 << REFS0) | (ADC_CANAL & 0x0F);          /* AVcc, ajuste a direita */
    DIDR0  = (1 << ADC0D);                               /* desliga buffer digital do pino */
    ADCSRA = (1 << ADEN) | (1 << ADIE) |
             (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0); /* prescaler 128 */
    /* conversoes disparadas pela ISR do Timer1 (timer.c) */
}

ISR(ADC_vect)
{
    uint16_t v = ADC;                       /* le ADCL e depois ADCH */
    ultima = v;

    if (!pronto) {
        /* primeira amostra preenche a janela inteira: evita que a media
         * comece em zero e seja interpretada como sensor desconectado */
        for (uint8_t i = 0; i < ADC_MEDIA_N; i++)
            janela[i] = v;
        soma = (uint16_t)(v * ADC_MEDIA_N);
        pronto = 1;
        return;
    }
    /* media movel recursiva: soma += nova - mais_antiga  (O(1)) */
    soma = (uint16_t)(soma + v - janela[idx]);
    janela[idx] = v;
    idx = (uint8_t)((idx + 1) & (ADC_MEDIA_N - 1));
}

uint16_t adc_soma(void)
{
    uint16_t s;
    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {     /* leitura de 16 bits atomica */
        s = soma;
    }
    return s;
}

uint16_t adc_ultima(void)
{
    uint16_t u;
    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
        u = ultima;
    }
    return u;
}

uint8_t adc_pronto(void)
{
    return pronto;
}

#ifndef ADC_H
#define ADC_H

#include <stdint.h>

void     adc_init(void);
uint16_t adc_soma(void);     /* soma das ultimas 32 amostras (0..32736) */
uint16_t adc_ultima(void);   /* ultima amostra bruta (0..1023)          */
uint8_t  adc_pronto(void);   /* 1 apos a primeira conversao             */

#endif

/*
 * board.h - Mapeamento de pinos e acesso direto aos registradores de E/S
 *
 * Pino         Funcao                      Arduino Uno
 * PC0/ADC0     sensor de nivel (analogico)  A0
 * PD0/RXD      USART RX                     D0
 * PD1/TXD      USART TX                     D1
 * PD2          botao "reconhecer alarme"    D2   (pull-up interno, ativo em 0)
 * PB0          rele da bomba (via NPN)      D8   (ativo em 1)
 * PB1          buzzer ativo (via NPN)       D9   (ativo em 1)
 * PB2          LED vermelho - alarme        D10
 * PB3          LED verde   - bomba ligada   D11
 * PB5          LED de vida (heartbeat)      D13  (LED da placa)
 */
#ifndef BOARD_H
#define BOARD_H

#include <avr/io.h>

#define PINO_BOMBA      PB0
#define PINO_BUZZER     PB1
#define PINO_LED_ALARME PB2
#define PINO_LED_BOMBA  PB3
#define PINO_LED_VIDA   PB5
#define PINO_BOTAO      PD2

#define SAIDAS_PORTB    ((1 << PINO_BOMBA) | (1 << PINO_BUZZER) | \
                         (1 << PINO_LED_ALARME) | (1 << PINO_LED_BOMBA) | \
                         (1 << PINO_LED_VIDA))

static inline void board_init(void)
{
    PORTB &= (uint8_t)~SAIDAS_PORTB;        /* tudo desligado antes de virar saida */
    DDRB  |= SAIDAS_PORTB;
    DDRD  &= (uint8_t)~(1 << PINO_BOTAO);   /* entrada */
    PORTD |= (1 << PINO_BOTAO);             /* pull-up interno */
}

static inline void saida(uint8_t pino, uint8_t ligado)
{
    if (ligado) PORTB |= (uint8_t)(1 << pino);
    else        PORTB &= (uint8_t)~(1 << pino);
}

static inline void saida_inverte(uint8_t pino)
{
    PINB = (uint8_t)(1 << pino);            /* escrever 1 em PINx inverte PORTx */
}

static inline uint8_t botao_pressionado(void)
{
    return (PIND & (1 << PINO_BOTAO)) == 0;
}

#endif /* BOARD_H */

