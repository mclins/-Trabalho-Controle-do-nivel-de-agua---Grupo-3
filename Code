        uart_puts_P(PSTR("nenhum"));
        return;
    }
    bool primeiro = true;
    for (uint8_t i = 0; i < AL_N; i++) {
        if (a & (1u << i)) {
            if (!primeiro) uart_putc(' ');
            puts_tab(NOME_AL, i);
            primeiro = false;
