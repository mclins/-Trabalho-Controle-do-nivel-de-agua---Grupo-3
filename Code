/*
 * controle.c - Controle liga/desliga com histerese e deteccao de falhas
 *
 * Executado a cada 100 ms. Todas as temporizacoes sao contadas em passos
 * de 100 ms; os parametros (em segundos) sao convertidos aqui.
 */
#include "controle.h"

#define SAT_INC16(x) do { if ((x) < 0xFFFFu) (x)++; } while (0)
#define SAT_INC32(x) do { if ((x) < 0xFFFFFFFFul) (x)++; } while (0)

/* Retorna true quando 'cond' permaneceu verdadeira por pelo menos 'n'
 * passos consecutivos. E o filtro temporal que impede que uma onda na
 * superficie ou um pico de ruido provoque uma transicao. */
static bool confirma(uint16_t *cont, bool cond, uint16_t n)
{
    if (!cond) {
        *cont = 0;
        return false;
    }
    SAT_INC16(*cont);
    return *cont >= n;
}

/* ------------------------------------------------------------------ */
/* Conversao ADC -> nivel                                              */
/* ------------------------------------------------------------------ */
/* Reta por dois pontos de calibracao (adc_zero -> 0 mm, adc_ref -> n_ref).
 * A entrada e a SOMA de 32 amostras: usar a soma (e nao a media
 * truncada) preserva a resolucao extra obtida pela sobreamostragem. */
int16_t ctrl_nivel_mm(const params_t *p, uint16_t adc_x32)
{
    int32_t num = ((int32_t)adc_x32 - (int32_t)CTRL_SOBREAMOSTRA * p->adc_zero) *
                  (int32_t)p->n_ref;
    int32_t den = (int32_t)CTRL_SOBREAMOSTRA * ((int32_t)p->adc_ref - (int32_t)p->adc_zero);
    int32_t q;

    if (den == 0)
        return 0;
    if (den < 0) {               /* sensor com inclinacao negativa */
        den = -den;
        num = -num;
    }
    if (num >= 0) q = (num + den / 2) / den;     /* arredondamento */
    else          q = -((-num + den / 2) / den);

    if (q < 0)     q = 0;
    if (q > 32767) q = 32767;
    return (int16_t)q;
}

uint8_t ctrl_percentual(const params_t *p, int16_t nivel_mm)
{
    int32_t pc;
    if (nivel_mm <= 0 || p->altura == 0)
        return 0;
    pc = ((int32_t)nivel_mm * 100 + p->altura / 2) / p->altura;
    return (uint8_t)(pc > 255 ? 255 : pc);
}

/* ------------------------------------------------------------------ */
/* Transicoes                                                          */
/* ------------------------------------------------------------------ */
static void liga(ctrl_t *c, motivo_t m)
{
    c->bomba     = true;
    c->estado    = EST_LIGADA;
    c->motivo    = m;
    c->t_ligada  = 0;
    c->t_janela  = 0;
    c->nivel_ref = c->nivel_mm;
    c->c_desl    = 0;
}

static void desliga(ctrl_t *c, motivo_t m)
{
    c->bomba       = false;
    c->estado      = EST_DESLIGADA;
    c->motivo      = m;
    c->t_desligada = 0;
    c->t_janela    = 0;
    c->nivel_ref   = c->nivel_mm;
    c->c_liga      = 0;
}

static void entra_falha(ctrl_t *c)
{
    c->estado     = EST_FALHA;
    c->t_falha    = 0;
    c->cmd_manual = false;
}

/* Com a bomba desligada o nivel so pode cair ou ficar parado. Uma subida
 * maior que sub_min dentro da janela indica entrada indevida de agua:
 * contato do rele soldado, bomba acionada por outro circuito, etc. */
static void janela_desligada(ctrl_t *c, const params_t *p)
{
    if ((int32_t)c->nivel_mm - c->nivel_ref >= (int32_t)p->sub_min)
        c->alarmes |= AL_INDEVIDO;
    c->nivel_ref = c->nivel_mm;
    c->t_janela  = 0;
}

/* ------------------------------------------------------------------ */
void ctrl_init(ctrl_t *c)
{
    *c = (ctrl_t){0};
    c->modo   = MODO_AUTO;
    c->estado = EST_DESLIGADA;
    c->motivo = MOT_NENHUM;
    /* t_desligada = 0: o tempo minimo desligada tambem vale apos a
     * energizacao (partida retardada), o que da tempo do filtro do ADC
     * se estabilizar e evita religar o motor logo apos uma queda de energia. */
}

void ctrl_passo(ctrl_t *c, const params_t *p, uint16_t adc_x32)
{
    const uint16_t n_conf = (uint16_t)(p->t_conf * CTRL_PASSOS_POR_S);
    const uint32_t n_jan  = (uint32_t)p->janela * CTRL_PASSOS_POR_S;
    uint16_t adc = (uint16_t)((adc_x32 + CTRL_SOBREAMOSTRA / 2) / CTRL_SOBREAMOSTRA);
    bool invalido, sensor_ok, fim_janela;

    SAT_INC32(c->passos);
    c->adc = adc;

    /* 1) Plausibilidade eletrica do sensor ----------------------------- */
    invalido = (adc < p->adc_fmin) || (adc > p->adc_fmax);
    if (confirma(&c->c_sens_ruim, invalido, CTRL_SENSOR_FALHA))
        c->alarmes |= AL_SENSOR;
    if (confirma(&c->c_sens_bom, !invalido, CTRL_SENSOR_OK))
        c->alarmes &= (uint8_t)~AL_SENSOR;
    sensor_ok = !invalido && !(c->alarmes & AL_SENSOR);

    /* 2) Nivel e alarmes de nivel critico (confirmacao + histerese) ---- */
    if (sensor_ok) {
        int16_t n = ctrl_nivel_mm(p, adc_x32);
        c->nivel_mm = n;
        if (confirma(&c->c_ca_on, n >= (int32_t)p->n_crit_a, n_conf))
            c->alarmes |= AL_CRIT_ALTO;
        if (confirma(&c->c_ca_off, n < (int32_t)p->n_crit_a - CTRL_HIST_ALARME_MM, n_conf))
            c->alarmes &= (uint8_t)~AL_CRIT_ALTO;
        if (confirma(&c->c_cb_on, n <= (int32_t)p->n_crit_b, n_conf))
            c->alarmes |= AL_CRIT_BAIXO;
        if (confirma(&c->c_cb_off, n > (int32_t)p->n_crit_b + CTRL_HIST_ALARME_MM, n_conf))
            c->alarmes &= (uint8_t)~AL_CRIT_BAIXO;
    } else {
        c->c_ca_on = c->c_ca_off = c->c_cb_on = c->c_cb_off = 0;
    }

    /* 3) Temporizadores ------------------------------------------------ */
    if (c->bomba) SAT_INC32(c->t_ligada);
    else          SAT_INC32(c->t_desligada);
    SAT_INC32(c->t_janela);
    if (!sensor_ok)
        c->t_janela = 0;                 /* janela reinicia quando o sensor volta */
    else if (c->t_janela == 1)
        c->nivel_ref = c->nivel_mm;      /* primeiro passo de uma nova janela */
    fim_janela = sensor_ok && p->janela && c->t_janela >= n_jan;

    /* 4) Maquina de estados da bomba ----------------------------------- */
    switch (c->estado) {
    case EST_DESLIGADA:
        if (fim_janela)
            janela_desligada(c, p);
        if (!sensor_ok || (c->alarmes & AL_CRIT_ALTO)) {
            c->c_liga = 0;
            c->cmd_manual = false;
            break;
        }
        if (c->modo == MODO_AUTO) {
            bool baixo = confirma(&c->c_liga, c->nivel_mm <= (int32_t)p->n_liga, n_conf);
            if (baixo && c->t_desligada >= (uint32_t)p->t_minoff * CTRL_PASSOS_POR_S)
                liga(c, MOT_NIVEL_BAIXO);
        } else {
            c->c_liga = 0;
            if (c->cmd_manual)
                liga(c, MOT_MANUAL);
        }
        break;

    case EST_LIGADA:
        /* intertravamentos: valem nos modos automatico e manual */
        if (!sensor_ok) {
            desliga(c, MOT_SENSOR);
            c->cmd_manual = false;
            break;
        }
        if (c->alarmes & AL_CRIT_ALTO) {
            desliga(c, MOT_CRIT_ALTO);
            c->cmd_manual = false;
            break;
        }
        if (c->modo == MODO_AUTO) {
            if (confirma(&c->c_desl, c->nivel_mm >= (int32_t)p->n_desl, n_conf)) {
                desliga(c, MOT_NIVEL_ALTO);
                c->tentativas = 0;               /* enchimento completo */
                c->alarmes &= (uint8_t)~AL_ABAST;
                break;
            }
        } else if (!c->cmd_manual) {
            desliga(c, MOT_MANUAL);
            break;
        }
        /* protecao: tempo maximo de funcionamento continuo */
        if (p->t_max && c->t_ligada >= (uint32_t)p->t_max * CTRL_PASSOS_POR_S) {
            desliga(c, MOT_TMAX);
            c->alarmes |= AL_TMAX;
            entra_falha(c);
            break;
        }
        /* protecao: a bomba ligada precisa fazer o nivel subir */
        if (fim_janela) {
            if ((int32_t)c->nivel_mm - c->nivel_ref < (int32_t)p->sub_min) {
                desliga(c, MOT_ABAST);
                c->alarmes |= AL_ABAST;
                if (c->tentativas < 255) c->tentativas++;
                if (c->tentativas > p->n_retry)
                    c->alarmes |= AL_BLOQUEIO;
                entra_falha(c);
            } else {
                c->alarmes &= (uint8_t)~AL_ABAST;   /* abastecimento normalizado */
                c->nivel_ref = c->nivel_mm;
                c->t_janela  = 0;
            }
        }
        break;

    case EST_FALHA:
        SAT_INC32(c->t_falha);
        if (fim_janela)
            janela_desligada(c, p);
        /* falha de abastecimento: nova tentativa automatica apos t_retry,
         * ate n_retry vezes. Tempo maximo e bloqueio exigem o operador. */
        if (!(c->alarmes & (AL_TMAX | AL_BLOQUEIO)) &&
            c->t_falha >= (uint32_t)p->t_retry * CTRL_PASSOS_POR_S) {
            c->estado = EST_DESLIGADA;
            c->motivo = MOT_NOVA_TENTATIVA;
        }
        break;
    }

    /* 5) Sinalizacao: qualquer alarme novo reativa o buzzer ------------- */
    if (c->alarmes & (uint8_t)~c->alarmes_ant)
        c->silenciado = false;
    c->alarmes_ant = c->alarmes;
    c->buzzer = (c->alarmes != 0) && !c->silenciado;
}

void ctrl_reconhece(ctrl_t *c)
{
    c->alarmes    &= (uint8_t)~AL_TRAVADOS;
    c->alarmes_ant = c->alarmes;
    c->tentativas  = 0;
    c->silenciado  = true;
    c->buzzer      = false;
    if (c->estado == EST_FALHA) {
        c->estado = EST_DESLIGADA;
        c->motivo = MOT_RECONHECIDO;
    }
}

void ctrl_modo(ctrl_t *c, modo_t m)
{
    if (m == c->modo)
        return;
    c->modo = m;
    /* transferencia sem solavanco: ao entrar no manual mantem o estado atual */
    c->cmd_manual = (m == MODO_MANUAL) ? c->bomba : false;
    c->c_liga = c->c_desl = 0;
}

bool ctrl_bomba_manual(ctrl_t *c, bool ligar)
{
    if (c->modo != MODO_MANUAL)
        return false;
    if (ligar && (c->estado == EST_FALHA || (c->alarmes & (AL_SENSOR | AL_CRIT_ALTO))))
        return false;
    c->cmd_manual = ligar;
    return true;
}

/*
 * controle.h - Logica de controle da bomba e deteccao de falhas.
 *
 * Modulo independente de hardware: recebe a leitura media do ADC a cada
 * passo de 100 ms e decide o estado da bomba e dos alarmes. Por nao
 * acessar registradores, e testado no PC (test/host) e reutilizado sem
 * alteracao no firmware.
 */
#ifndef CONTROLE_H
#define CONTROLE_H

#include <stdint.h>
#include <stdbool.h>
#include "params.h"

#define CTRL_PASSOS_POR_S   10u     /* ctrl_passo() chamado a 10 Hz       */
#define CTRL_SOBREAMOSTRA   32u     /* entrada = soma de 32 amostras ADC  */
#define CTRL_SENSOR_FALHA   10u     /* 1 s invalido -> alarme de sensor   */
#define CTRL_SENSOR_OK      30u     /* 3 s valido   -> limpa o alarme     */
#define CTRL_HIST_ALARME_MM 10      /* histerese dos alarmes criticos (mm) */

/* Bits de alarme */
#define AL_SENSOR     0x01u  /* leitura fora da faixa eletrica do sensor    */
#define AL_CRIT_BAIXO 0x02u  /* nivel criticamente baixo                    */
#define AL_CRIT_ALTO  0x04u  /* nivel criticamente alto (risco de transbordo)*/
#define AL_ABAST      0x08u  /* bomba ligada sem subida de nivel (fonte seca,
                                bomba/tubulacao com defeito)                 */
#define AL_TMAX       0x10u  /* bomba ligada alem do tempo maximo           */
#define AL_BLOQUEIO   0x20u  /* tentativas esgotadas: exige reconhecimento  */
#define AL_INDEVIDO   0x40u  /* nivel subindo com a bomba desligada
                                (rele colado, valvula/entrada indevida)      */
#define AL_TRAVADOS   (AL_ABAST | AL_TMAX | AL_BLOQUEIO | AL_INDEVIDO)
#define AL_N          7u

typedef enum { MODO_AUTO = 0, MODO_MANUAL = 1 } modo_t;

typedef enum {
    EST_DESLIGADA = 0,   /* aguardando nivel baixo                      */
    EST_LIGADA,          /* enchendo                                    */
    EST_FALHA            /* bomba bloqueada por falha de abastecimento  */
} estado_t;

typedef enum {
    MOT_NENHUM = 0,
    MOT_NIVEL_BAIXO,     /* liga: nivel <= n_liga                        */
    MOT_NIVEL_ALTO,      /* desliga: nivel >= n_desl                     */
    MOT_MANUAL,          /* comando do operador                          */
    MOT_SENSOR,          /* desliga por falha do sensor                  */
    MOT_CRIT_ALTO,       /* desliga por nivel critico alto               */
    MOT_ABAST,           /* desliga por falha de abastecimento           */
    MOT_TMAX,            /* desliga por tempo maximo                     */
    MOT_NOVA_TENTATIVA,  /* sai do estado de falha apos t_retry          */
    MOT_RECONHECIDO      /* sai do estado de falha por reconhecimento    */
} motivo_t;

typedef struct {
    /* saidas e estado observavel */
    modo_t   modo;
    estado_t estado;
    bool     bomba;          /* comando do rele                          */
    bool     buzzer;         /* ha alarme nao reconhecido                */
    uint8_t  alarmes;
    uint8_t  tentativas;
    motivo_t motivo;         /* motivo da ultima transicao da bomba      */
    int16_t  nivel_mm;       /* ultima estimativa valida                 */
    uint16_t adc;            /* media do ADC (LSB)                       */
    uint32_t passos;         /* tempo desde o boot, em passos de 100 ms  */

    /* estado interno */
    bool     cmd_manual;
    bool     silenciado;
    uint8_t  alarmes_ant;
    uint16_t c_liga, c_desl;             /* confirmacao dos limiares     */
    uint16_t c_ca_on, c_ca_off;          /* critico alto                 */
    uint16_t c_cb_on, c_cb_off;          /* critico baixo                */
    uint16_t c_sens_ruim, c_sens_bom;
    uint32_t t_ligada, t_desligada, t_janela, t_falha;
    int16_t  nivel_ref;                  /* inicio da janela de subida   */
} ctrl_t;

void    ctrl_init(ctrl_t *c);
void    ctrl_passo(ctrl_t *c, const params_t *p, uint16_t adc_x32);
void    ctrl_reconhece(ctrl_t *c);
void    ctrl_modo(ctrl_t *c, modo_t m);
bool    ctrl_bomba_manual(ctrl_t *c, bool ligar);   /* false = recusado */
int16_t ctrl_nivel_mm(const params_t *p, uint16_t adc_x32);
uint8_t ctrl_percentual(const params_t *p, int16_t nivel_mm);

#endif /* CONTROLE_H */

/*
 * main.c - Sistema inteligente de controle de nivel de agua (ATmega328P)
 *
 * ENGC50 - Sistemas Microprocessados - UFBA - 2026.2 - Problema 2
 *
 * Organizacao das tarefas (primeiro plano / segundo plano):
 *
 *   ISR TIMER1_COMPA (10 ms) -> dispara ADC, debounce do botao, conta passos
 *   ISR ADC                  -> media movel de 32 amostras
 *   ISR USART_RX / UDRE      -> buffers circulares de recepcao/transmissao
 *
 *   laco principal           -> comandos seriais, controle (100 ms),
 *                               saidas, eventos, telemetria; dorme (IDLE)
 *                               quando nao ha trabalho
 *
 * Nenhuma tarefa espera ativamente por outra: cada ISR e curta e o laco
 * principal so processa o que ja esta pronto.
 */
#include <avr/io.h>
#include <avr/interrupt.h>
#include <avr/pgmspace.h>
#include <avr/sleep.h>
#include <avr/wdt.h>
#include "config.h"
#include "board.h"
#include "timer.h"
#include "adc.h"
#include "uart.h"
#include "params.h"
#include "controle.h"
#include "protocolo.h"

static params_t P;
static ctrl_t   C;

/* Causa do reset: MCUSR precisa ser lido e zerado logo no inicio, antes
 * de main(), e o watchdog desligado; senao um reset por watchdog vira um
 * laco de resets (o WDT continua ativo apos o reset). */
static uint8_t mcusr_copia __attribute__((section(".noinit")));
void le_mcusr(void) __attribute__((naked, used, section(".init3")));
void le_mcusr(void)
{
    mcusr_copia = MCUSR;
    MCUSR = 0;
    wdt_disable();
}

void app_salvar(void)
{
    params_salva(&P);
}

uint8_t app_carregar(void)
{
    return params_carrega(&P);
}

/* Padrao do buzzer e dos LEDs, avaliado a cada 100 ms */
static void atualiza_saidas(void)
{
    static uint8_t fase;                    /* 0..9: ciclo de 1 s */
    fase = (uint8_t)((fase + 1u) % 10u);

    saida(PINO_BOMBA, C.bomba);
    saida(PINO_LED_BOMBA, C.bomba);
    saida(PINO_LED_ALARME, C.alarmes != 0);

    /* falhas que bloqueiam a bomba: bipe 0,5 s ligado / 0,5 s desligado;
     * avisos (nivel critico, entrada indevida): bipe curto de 0,2 s */
    uint8_t grave = C.alarmes & (AL_SENSOR | AL_ABAST | AL_TMAX | AL_BLOQUEIO | AL_CRIT_ALTO);
    uint8_t bip   = grave ? (fase < 5) : (fase < 2);
    saida(PINO_BUZZER, C.buzzer && bip);

    if (fase == 0)
        saida_inverte(PINO_LED_VIDA);       /* pisca: firmware vivo */
}

int main(void)
{
    uint8_t da_eeprom;

    board_init();
    da_eeprom = params_carrega(&P);
    ctrl_init(&C);
    uart_init();
    adc_init();
    timer_init();
    prot_init(&P, &C);

    set_sleep_mode(SLEEP_MODE_IDLE);        /* timers, ADC e USART seguem ativos */
    wdt_enable(WDTO_1S);
    sei();

    prot_boot(mcusr_copia & 0x0F, da_eeprom);

    for (;;) {
        int ch;

        wdt_reset();

        while ((ch = uart_getc()) >= 0)
            prot_rx((char)ch);
        if (uart_estouro_rx())
            uart_puts_P(PSTR("ERRO: estouro do buffer de recepcao\r\n"));

        while (timer_pega_passo()) {
            if (adc_pronto())
                ctrl_passo(&C, &P, adc_soma());
            atualiza_saidas();
            prot_pos_passo();
        }

        if (timer_pega_botao())
            prot_botao();

        /* Dorme ate a proxima interrupcao. As interrupcoes sao desligadas
         * para testar se ha trabalho; sei seguido de sleep e atomico no
         * AVR, entao uma interrupcao entre o teste e o sleep nao se perde. */
        cli();
        if (!timer_ha_trabalho()) {
            sleep_enable();
            sei();
            sleep_cpu();
            sleep_disable();
        }
        sei();
    }
}

/*
 * params.c - Valores padrao, validacao e persistencia dos parametros
 */
#include "params.h"

#ifdef __AVR__
#include <avr/eeprom.h>
#endif

/*
 * Valores padrao para um reservatorio de teste com 500 mm de altura util
 * e sensor MPX5010DP alimentado com 5 V (curva nominal do datasheet):
 *   Vout = Vs (0,09 P + 0,04),  P em kPa,  P = rho g h
 *   h = 0      -> 0,200 V -> ADC =  41
 *   h = 500 mm -> 2,407 V -> ADC = 493   (~0,9 LSB/mm)
 */
void params_padrao(params_t *p)
{
    p->n_liga   = 200;
    p->n_desl   = 420;
    p->n_crit_b = 80;
    p->n_crit_a = 470;
    p->altura   = 500;
    p->adc_zero = 41;
    p->adc_ref  = 493;
    p->n_ref    = 500;
    p->adc_fmin = 15;    /* ~73 mV: abaixo do offset minimo do sensor (88 mV) */
    p->adc_fmax = 1010;  /* ~4,93 V: acima do fundo de escala do sensor (4,7 V) */
    p->t_conf   = 2;
    p->t_minoff = 10;
    p->t_max    = 900;
    p->janela   = 30;
    p->sub_min  = 10;
    p->t_retry  = 300;
    p->n_retry  = 2;
    p->telem    = 5;
}

param_erro_t params_valida(const params_t *p)
{
    if (!(p->n_crit_b < p->n_liga && p->n_liga < p->n_desl &&
          p->n_desl < p->n_crit_a && p->n_crit_a <= p->altura))
        return PARAM_ERR_ORDEM;

    int16_t d = (int16_t)p->adc_ref - (int16_t)p->adc_zero;
    if (d < 0) d = (int16_t)-d;
    if (p->n_ref == 0 || d < 10 || p->adc_ref > 1023 || p->adc_zero > 1023)
        return PARAM_ERR_CAL;

    if (p->adc_fmin >= p->adc_fmax)
        return PARAM_ERR_FAIXA_ADC;

    if (p->janela > 0 && p->sub_min == 0)
        return PARAM_ERR_JANELA;

    return PARAM_OK;
}

uint16_t params_get(const params_t *p, uint8_t idx)
{
    return ((const uint16_t *)p)[idx];
}

void params_set(params_t *p, uint8_t idx, uint16_t v)
{
    ((uint16_t *)p)[idx] = v;
}

#ifdef __AVR__
/* ------------------------------------------------------------------ */
/* Bloco na EEPROM: [marca][versao][parametros][CRC-16]                */
/* ------------------------------------------------------------------ */
#define EE_MARCA 0xA55Au

typedef struct {
    uint16_t marca;
    uint16_t versao;
    params_t p;
    uint16_t crc;
} ee_bloco_t;

static ee_bloco_t EEMEM ee_bloco;

/* CRC-16/CCITT (polinomio 0x1021) */
static uint16_t crc16(const uint8_t *d, uint16_t n)
{
    uint16_t crc = 0xFFFF;
    while (n--) {
        crc ^= (uint16_t)(*d++) << 8;
        for (uint8_t i = 0; i < 8; i++)
            crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
    }
    return crc;
}

uint8_t params_carrega(params_t *p)
{
    ee_bloco_t b;
    eeprom_read_block(&b, &ee_bloco, sizeof b);
    if (b.marca == EE_MARCA && b.versao == PARAMS_VERSAO &&
        b.crc == crc16((const uint8_t *)&b.p, sizeof b.p) &&
        params_valida(&b.p) == PARAM_OK) {
        *p = b.p;
        return 1;
    }
    params_padrao(p);
    return 0;
}

void params_salva(const params_t *p)
{
    ee_bloco_t b;
    b.marca  = EE_MARCA;
    b.versao = PARAMS_VERSAO;
    b.p      = *p;
    b.crc    = crc16((const uint8_t *)&b.p, sizeof b.p);
    /* eeprom_update_block so grava os bytes que mudaram: reduz desgaste
     * (100 mil ciclos por celula) e tempo de escrita (~3,4 ms/byte). */
    eeprom_update_block(&b, &ee_bloco, sizeof b);
}
#endif

/*
 * params.h - Parametros de operacao configuraveis pela serial e
 * persistidos na EEPROM.
 */
#ifndef PARAMS_H
#define PARAMS_H

#include <stdint.h>

/* Todos os campos sao uint16_t para permitir uma tabela generica de
 * acesso (comando SET/PARAMS). A ordem dos campos define o layout na
 * EEPROM: ao alterar, incremente PARAMS_VERSAO. */
typedef struct {
    uint16_t n_liga;     /* mm  - liga a bomba quando nivel <= n_liga        */
    uint16_t n_desl;     /* mm  - desliga a bomba quando nivel >= n_desl     */
    uint16_t n_crit_b;   /* mm  - alarme de nivel criticamente baixo         */
    uint16_t n_crit_a;   /* mm  - alarme de nivel criticamente alto          */
    uint16_t altura;     /* mm  - altura util do reservatorio (100 %)        */
    uint16_t adc_zero;   /* LSB - leitura do ADC com o reservatorio vazio    */
    uint16_t adc_ref;    /* LSB - leitura do ADC no nivel de referencia      */
    uint16_t n_ref;      /* mm  - nivel de referencia da calibracao          */
    uint16_t adc_fmin;   /* LSB - abaixo disso: sensor aberto/em curto p/ GND */
    uint16_t adc_fmax;   /* LSB - acima disso: sensor em curto p/ VCC        */
    uint16_t t_conf;     /* s   - tempo de confirmacao de cruzamento         */
    uint16_t t_minoff;   /* s   - tempo minimo com a bomba desligada         */
    uint16_t t_max;      /* s   - tempo maximo ligada (0 = desabilitado)     */
    uint16_t janela;     /* s   - janela de verificacao de subida (0 = desab.) */
    uint16_t sub_min;    /* mm  - subida minima esperada por janela          */
    uint16_t t_retry;    /* s   - espera antes de nova tentativa             */
    uint16_t n_retry;    /* -   - tentativas automaticas antes do bloqueio   */
    uint16_t telem;      /* s   - periodo da telemetria (0 = desligada)      */
} params_t;

#define PARAMS_N        (sizeof(params_t) / sizeof(uint16_t))
#define PARAMS_VERSAO   1u

/* Codigos de validacao */
typedef enum {
    PARAM_OK = 0,
    PARAM_ERR_ORDEM,     /* exige crit_b < liga < desl < crit_a <= altura */
    PARAM_ERR_CAL,       /* calibracao degenerada                         */
    PARAM_ERR_FAIXA_ADC, /* adc_fmin >= adc_fmax                          */
    PARAM_ERR_JANELA     /* janela > 0 exige sub_min > 0                  */
} param_erro_t;

void         params_padrao(params_t *p);
param_erro_t params_valida(const params_t *p);

/* Acesso generico por indice (usado pelo interpretador de comandos) */
uint16_t     params_get(const params_t *p, uint8_t idx);
void         params_set(params_t *p, uint8_t idx, uint16_t v);

#ifdef __AVR__
/* Persistencia: retorna 1 se carregou da EEPROM, 0 se usou o padrao */
uint8_t      params_carrega(params_t *p);
void         params_salva(const params_t *p);
#endif

#endif /* PARAMS_H */

